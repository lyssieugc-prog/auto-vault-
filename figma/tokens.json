{
  "$description": "House-style design tokens. Figma variables and Roblox UI must use these names. Profiles may override per game in games/<slug>/figma/tokens.override.json.",
  "color": {
    "panel": "#1E1B33",
    "panelGirly": "#3B2450",
    "panelRealistic": "#2A2F3A",
    "stroke": "#1A1A1A",
    "textPrimary": "#FFFFFF",
    "gold": "#FFD93B",
    "lime": "#A8F03C",
    "red": "#E13A2A",
    "redDark": "#B6261D",
    "green": "#7ADE43",
    "greenLip": "#57AC35",
    "blue": "#2590D1",
    "blueAlt": "#326BE3",
    "yellow": "#E2C608",
    "purple": "#B678EA",
    "pink": "#DD70E1",
    "limeDeep": "#78BE0E"
  },
  "rarity": {
    "Common": "#BFC3C9",
    "Uncommon": "#7ADE43",
    "Rare": "#2590D1",
    "Epic": "#B678EA",
    "Legendary": "#FFD93B",
    "Mythic": "rainbow-animated",
    "Secret": "#1A1A1A"
  },
  "font": {
    "title": { "figma": "Fredoka One", "roblox": "Enum.Font.FredokaOne" },
    "banner": { "figma": "Gotham Black", "roblox": "Enum.Font.GothamBlack" },
    "body": { "figma": "Fredoka One", "roblox": "Enum.Font.FredokaOne" }
  },
  "stroke": { "textSmall": 2, "textLarge": 4, "frameOuter": 4 },
  "radius": { "button": 0.3, "card": 0.15, "panel": 0.08 },
  "button": { "lipPx": 5, "glossOpacity": 0.35, "pressScale": 0.95, "hoverScale": 1.05, "hoverTiltDeg": -2 },
  "tag": { "rotationMinDeg": -10, "rotationMaxDeg": -3 },
  "motion": {
    "popOpenSeconds": 0.35,
    "popOpenEasing": "Back.Out",
    "staggerSeconds": 0.05,
    "sunburstSecondsPerTurn": 25
  },
  "touch": { "minTargetPx": 44 }
}
