local Stealing = require("../../src/Shared/Stealing")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Stealing", function()
		local function make()
			local clock = t.clock(100)
			local s = Stealing.new({
				stealDuration = 2,
				lockDuration = 60,
				lockCooldown = 30,
				thiefCooldown = 5,
				now = clock.now,
			})
			return s, clock
		end
		it("full steal flow", function()
			local s, clock = make()
			expect(s:startSteal(2, 1, "i1")).toBe(true)
			local ok, err = s:grab(2)
			expect(ok).toBe(false)
			expect(err).toBe("too_fast")
			clock.advance(2)
			expect(s:grab(2)).toBe(true)
			expect(s:carrying(2)).toBeTruthy()
			local result = s:completeSteal(2)
			expect(result.ownerId).toBe(1)
			expect(result.itemUid).toBe("i1")
			expect(s:carrying(2)).toBeNil()
		end)
		it("cannot steal from self, twice at once, or same item", function()
			local s, clock = make()
			local _, e1 = s:startSteal(1, 1, "i1")
			expect(e1).toBe("own_base")
			s:startSteal(2, 1, "i1")
			local _, e2 = s:startSteal(2, 1, "i2")
			expect(e2).toBe("busy")
			clock.advance(10)
			local _, e3 = s:startSteal(3, 1, "i1")
			expect(e3).toBe("taken")
		end)
		it("thief cooldown", function()
			local s, clock = make()
			s:startSteal(2, 1, "i1")
			s:cancelSteal(2)
			local _, err = s:startSteal(2, 1, "i1")
			expect(err).toBe("cooldown")
			clock.advance(5)
			expect(s:startSteal(2, 1, "i1")).toBe(true)
		end)
		it("lock protects, kicks in-progress thieves, then cools down", function()
			local s, clock = make()
			s:startSteal(2, 1, "i1")
			expect(s:lockBase(1)).toBe(true)
			expect(s:completeSteal(2)).toBeNil()
			clock.advance(6)
			local _, err = s:startSteal(2, 1, "i1")
			expect(err).toBe("protected")
			local _, lockErr = s:lockBase(1)
			expect(lockErr).toBe("already_locked")
			clock.advance(60)
			local _, cd = s:lockBase(1)
			expect(cd).toBe("cooldown")
			expect(s:startSteal(2, 1, "i1")).toBe(true)
			clock.advance(30)
			expect(s:lockBase(1)).toBe(true)
		end)
		it("lock does not cancel a thief already carrying", function()
			local s, clock = make()
			s:startSteal(2, 1, "i1")
			clock.advance(2)
			s:grab(2)
			s:lockBase(1)
			expect(s:completeSteal(2)).toBeTruthy()
		end)
		it("shields stack and expire", function()
			local s, clock = make()
			s:setShield(1, 10)
			s:setShield(1, 10)
			expect(s:protectionRemaining(1)).toBe(20)
			clock.advance(21)
			expect(s:isProtected(1)).toBe(false)
		end)
		it("removePlayer clears steals against them", function()
			local s = make()
			s:startSteal(2, 1, "i1")
			s:removePlayer(1)
			expect(s:completeSteal(2)).toBeNil()
		end)
	end)
end
