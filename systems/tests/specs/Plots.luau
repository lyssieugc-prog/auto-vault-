local Plots = require("../../src/Shared/Plots")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Plots", function()
		it("assigns lowest free plot, idempotently", function()
			local p = Plots.new({ count = 3 })
			expect(p:claim(10)).toBe(1)
			expect(p:claim(20)).toBe(2)
			expect(p:claim(10)).toBe(1)
			expect(p:freeCount()).toBe(1)
		end)
		it("honours preferred plot and fills gaps", function()
			local p = Plots.new({ count = 3 })
			expect(p:claim(1, 3)).toBe(3)
			expect(p:claim(2, 3)).toBe(1)
			p:release(2)
			expect(p:ownerOf(1)).toBeNil()
			expect(p:claim(4)).toBe(1)
		end)
		it("returns nil when full and reports ownership", function()
			local p = Plots.new({ count = 1 })
			local events = {}
			p:onChanged(function(index, owner)
				table.insert(events, { index, owner })
			end)
			p:claim(1)
			expect(p:claim(2)).toBeNil()
			expect(p:isOwner(1, 1)).toBe(true)
			expect(p:isOwner(2, 1)).toBe(false)
			p:release(1)
			expect(#events).toBe(2)
			expect(events[2][2]).toBeNil()
		end)
	end)
end
