local Tutorial = require("../../src/Shared/Tutorial")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Tutorial", function()
		local tut = Tutorial.new({ steps = { { id = "a" }, { id = "b" }, { id = "c" } } })
		it("advances only on the current step", function()
			local s = Tutorial.newState()
			expect(tut:current(s).id).toBe("a")
			local _, changed = tut:complete(s, "b")
			expect(changed).toBe(false)
			local nextStep = tut:complete(s, "a")
			expect(nextStep.id).toBe("b")
			tut:complete(s, "b")
			tut:complete(s, "c")
			expect(tut:isDone(s)).toBe(true)
			expect(tut:current(s)).toBeNil()
			local done, total = tut:progress(s)
			expect(done).toBe(3)
			expect(total).toBe(3)
		end)
		it("skip", function()
			local s = Tutorial.newState()
			tut:skip(s)
			expect(tut:isDone(s)).toBe(true)
		end)
	end)
end
