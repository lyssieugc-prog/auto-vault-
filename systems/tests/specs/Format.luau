local Format = require("../../src/Shared/Format")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Format", function()
		it("abbreviates", function()
			expect(Format.abbreviate(0)).toBe("0")
			expect(Format.abbreviate(999)).toBe("999")
			expect(Format.abbreviate(1000)).toBe("1K")
			expect(Format.abbreviate(1234)).toBe("1.2K")
			expect(Format.abbreviate(1500000)).toBe("1.5M")
			expect(Format.abbreviate(10000)).toBe("10K")
			expect(Format.abbreviate(7e9)).toBe("7B")
			expect(Format.abbreviate(-2500)).toBe("-2.5K")
			expect(Format.abbreviate(1e15)).toBe("1Qa")
		end)
		it("handles nan/inf", function()
			expect(Format.abbreviate(0 / 0)).toBe("0")
			expect(Format.abbreviate(math.huge)).toBe("inf")
		end)
		it("adds commas", function()
			expect(Format.commas(1234567)).toBe("1,234,567")
			expect(Format.commas(999)).toBe("999")
			expect(Format.commas(-1000)).toBe("-1,000")
		end)
		it("formats countdowns", function()
			expect(Format.countdown(309)).toBe("05:09")
			expect(Format.countdown(3720)).toBe("1h 02m")
			expect(Format.countdown(2 * 86400 + 3 * 3600)).toBe("2d 03h")
			expect(Format.countdown(-5)).toBe("00:00")
		end)
	end)
end
