local Boosts = require("../../src/Shared/Boosts")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Boosts", function()
		local function make()
			local clock = t.clock(1000)
			local b = Boosts.new({
				defs = { CashX2 = { multiplier = 2, label = "x2 Cash" }, LuckX2 = { multiplier = 3 } },
				maxSeconds = 3600,
				now = clock.now,
			})
			return b, clock, Boosts.newState()
		end
		it("grants, multiplies while active, expires on the server clock", function()
			local b, clock, state = make()
			expect(b:multiplier(state, "CashX2")).toBe(1)
			expect(b:grant(state, "CashX2", 600)).toBe(600)
			expect(b:multiplier(state, "CashX2")).toBe(2)
			clock.advance(599)
			expect(b:remaining(state, "CashX2")).toBe(1)
			clock.advance(1)
			expect(b:isActive(state, "CashX2")).toBe(false)
			expect(b:multiplier(state, "CashX2")).toBe(1)
		end)
		it("stacks duration up to the cap and rejects bad input", function()
			local b, _, state = make()
			b:grant(state, "LuckX2", 3000)
			expect(b:grant(state, "LuckX2", 3000)).toBe(3600)
			local none, err = b:grant(state, "Nope", 10)
			expect(none).toBeNil()
			expect(err).toBe("unknown")
			local _, bad = b:grant(state, "CashX2", 0 / 0)
			expect(bad).toBe("invalid")
			local _, neg = b:grant(state, "CashX2", -5)
			expect(neg).toBe("invalid")
		end)
		it("lists active boosts and prunes expired / unknown ones", function()
			local b, clock, state = make()
			b:grant(state, "CashX2", 100)
			b:grant(state, "LuckX2", 500)
			state.active.Legacy = 99999
			local list = b:list(state)
			expect(#list).toBe(2)
			expect(list[1].name).toBe("CashX2")
			expect(list[1].label).toBe("x2 Cash")
			clock.advance(200)
			local expired = b:prune(state)
			expect(#expired).toBe(2)
			expect(expired[1]).toBe("CashX2")
			expect(expired[2]).toBe("Legacy")
			expect(state.active.LuckX2 ~= nil).toBe(true)
		end)
	end)
end
