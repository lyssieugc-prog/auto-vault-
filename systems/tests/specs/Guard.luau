local Guard = require("../../src/Shared/Guard")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Guard", function()
		it("validates primitives", function()
			expect(Guard.number(5, 0, 10)).toBe(true)
			expect(Guard.number(0 / 0)).toBe(false)
			expect(Guard.number(math.huge)).toBe(false)
			expect(Guard.number("5")).toBe(false)
			expect(Guard.integer(2.5)).toBe(false)
			expect(Guard.integer(3, 1, 3)).toBe(true)
			expect(Guard.string(string.rep("x", 201))).toBe(false)
			expect(Guard.oneOf("Egg1", { "Egg1", "Egg2" })).toBe(true)
			expect(Guard.oneOf("Egg9", { "Egg1" })).toBe(false)
		end)
		it("validates string lists", function()
			expect(Guard.stringList({ "a", "b" }, 3)).toBe(true)
			expect(Guard.stringList({ "a", "a" }, 3)).toBe(false)
			expect(Guard.stringList({ "a", "b", "c", "d" }, 3)).toBe(false)
			expect(Guard.stringList({ a = "x" }, 3)).toBe(false)
			expect(Guard.stringList({ "a", 5 }, 3)).toBe(false)
		end)
		it("rate limits with refill", function()
			local clock = t.clock(0)
			local rl = Guard.rateLimiter({ rate = 1, burst = 2, now = clock.now })
			expect(rl:allow(1, "x")).toBe(true)
			expect(rl:allow(1, "x")).toBe(true)
			expect(rl:allow(1, "x")).toBe(false)
			expect(rl:allow(2, "x")).toBe(true)
			clock.advance(1)
			expect(rl:allow(1, "x")).toBe(true)
			rl:removePlayer(1)
			expect(rl:allow(1, "x")).toBe(true)
		end)
	end)
end
