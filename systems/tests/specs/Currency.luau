local Currency = require("../../src/Shared/Currency")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Currency", function()
		local function make()
			local c = Currency.new({ currencies = { Cash = { start = 10 }, Gems = { start = 0, max = 100 } } })
			c:load(1)
			return c
		end
		it("loads defaults and saved values", function()
			local c = make()
			expect(c:get(1, "Cash")).toBe(10)
			c:load(2, { Cash = 500, Gems = -5 })
			expect(c:get(2, "Cash")).toBe(500)
			expect(c:get(2, "Gems")).toBe(0) -- invalid saved value falls back to start
		end)
		it("spends atomically and rejects invalid amounts", function()
			local c = make()
			expect(c:spend(1, "Cash", 4)).toBe(true)
			expect(c:get(1, "Cash")).toBe(6)
			expect(c:spend(1, "Cash", 7)).toBe(false)
			expect(c:spend(1, "Cash", -1)).toBe(false)
			expect(c:spend(1, "Cash", 0 / 0)).toBe(false)
			expect(c:add(1, "Cash", math.huge)).toBe(0)
			expect(c:get(1, "Cash")).toBe(6)
		end)
		it("clamps to max", function()
			local c = make()
			expect(c:add(1, "Gems", 150)).toBe(100)
			expect(c:get(1, "Gems")).toBe(100)
		end)
		it("applies stacked multipliers on earn", function()
			local c = make()
			c:setMultiplier(1, "Rebirth", 2)
			c:setMultiplier(1, "Pass", 3, "Cash")
			c:setMultiplier(1, "GemOnly", 10, "Gems")
			expect(c:multiplier(1, "Cash")).toBe(6)
			c:earn(1, "Cash", 5)
			expect(c:get(1, "Cash")).toBe(40)
			c:setMultiplier(1, "Rebirth", nil)
			expect(c:multiplier(1, "Cash")).toBe(3)
		end)
		it("passive income carries fractions", function()
			local c = make()
			c:setIncome(1, "Plot", "Cash", 1.5)
			c:step(1)
			expect(c:get(1, "Cash")).toBe(11)
			c:step(1)
			expect(c:get(1, "Cash")).toBe(13)
			expect(c:incomePerSecond(1, "Cash")).toBe(1.5)
			c:setIncome(1, "Plot", "Cash", 0)
			c:step(10)
			expect(c:get(1, "Cash")).toBe(13)
		end)
		it("emits change events", function()
			local c = make()
			local seen = {}
			local off = c:onChanged(function(_, name, balance, delta)
				table.insert(seen, { name, balance, delta })
			end)
			c:add(1, "Cash", 5)
			off()
			c:add(1, "Cash", 5)
			expect(#seen).toBe(1)
			expect(seen[1][2]).toBe(15)
		end)
		it("errors on unknown currency / unloaded wallet", function()
			local c = make()
			expect(function()
				c:get(1, "Nope")
			end).toThrow()
			expect(function()
				c:get(99, "Cash")
			end).toThrow()
		end)
		it("serializes", function()
			local c = make()
			c:add(1, "Gems", 3)
			expect(c:serialize(1)).toEqual({ Cash = 10, Gems = 3 })
		end)
	end)
end
