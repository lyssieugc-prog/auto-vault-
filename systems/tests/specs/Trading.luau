local Currency = require("../../src/Shared/Currency")
local Inventory = require("../../src/Shared/Inventory")
local Trading = require("../../src/Shared/Trading")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Trading", function()
		local function make(capacity: number?)
			local clock = t.clock(0)
			local inv = Inventory.new({ capacity = capacity or 10 })
			local cur = Currency.new({ currencies = { Gems = { start = 100 }, Cash = { start = 0 } } })
			for _, id in { 1, 2 } do
				inv:load(id)
				cur:load(id)
			end
			local tr = Trading.new({
				inventory = inv,
				currency = cur,
				tradableCurrencies = { "Gems" },
				confirmDelay = 3,
				now = clock.now,
			})
			return tr, inv, cur, clock
		end
		local function openSession(tr)
			tr:request(1, 2)
			expect(tr:accept(2, 1)).toBe(true)
		end
		it("completes a fair trade with items and currency", function()
			local tr, inv, cur, clock = make()
			local a = inv:add(1, { id = "Shark" })
			local b = inv:add(2, { id = "Cat" })
			openSession(tr)
			expect(tr:setOffer(1, { a }, { Gems = 30 })).toBe(true)
			expect(tr:setOffer(2, { b })).toBe(true)
			expect(inv:isLocked(1, a)).toBe(true)
			tr:ready(1)
			tr:ready(2)
			local _, early = tr:confirm(1)
			expect(early).toBe("too_early")
			clock.advance(3)
			local _, waiting = tr:confirm(1)
			expect(waiting).toBe("waiting")
			expect(tr:confirm(2)).toBe(true)
			expect(inv:has(1, a)).toBe(false)
			expect(inv:count(1)).toBe(1)
			expect(inv:count(2)).toBe(1)
			expect(cur:get(1, "Gems")).toBe(70)
			expect(cur:get(2, "Gems")).toBe(130)
			expect(tr:sessionOf(1)).toBeNil()
		end)
		it("changing an offer clears ready flags (anti-scam)", function()
			local tr, inv, _, clock = make()
			local a = inv:add(1, { id = "Shark" })
			local a2 = inv:add(1, { id = "Dirt" })
			openSession(tr)
			tr:setOffer(1, { a })
			tr:ready(1)
			tr:ready(2)
			tr:setOffer(1, { a2 })
			expect(inv:isLocked(1, a)).toBe(false)
			expect(inv:isLocked(1, a2)).toBe(true)
			clock.advance(5)
			local ok, err = tr:confirm(2)
			expect(ok).toBe(false)
			expect(err).toBe("not_ready")
		end)
		it("rejects items not owned, duplicates, untradable currency, overspend", function()
			local tr, inv = make()
			local a = inv:add(1, { id = "Shark" })
			openSession(tr)
			local _, e1 = tr:setOffer(1, { "i99" })
			expect(e1).toBe("invalid_item")
			local _, e2 = tr:setOffer(1, { a, a })
			expect(e2).toBe("invalid_item")
			local _, e3 = tr:setOffer(1, {}, { Cash = 1 })
			expect(e3).toBe("invalid_currency")
			local _, e4 = tr:setOffer(1, {}, { Gems = 1000 })
			expect(e4).toBe("funds")
			local _, e5 = tr:setOffer(1, {}, { Gems = 1.5 })
			expect(e5).toBe("invalid_amount")
		end)
		it("cancel unlocks items; requests expire; no self trades", function()
			local tr, inv, _, clock = make()
			local a = inv:add(1, { id = "Shark" })
			openSession(tr)
			tr:setOffer(1, { a })
			tr:cancel(2)
			expect(inv:isLocked(1, a)).toBe(false)
			expect(tr:sessionOf(1)).toBeNil()
			local _, selfErr = tr:request(1, 1)
			expect(selfErr).toBe("self")
			tr:request(1, 2)
			clock.advance(31)
			local _, expired = tr:accept(2, 1)
			expect(expired).toBe("expired")
		end)
		it("aborts when receiver would overflow capacity", function()
			local tr, inv, _, clock = make(1)
			local a = inv:add(1, { id = "Shark" })
			inv:add(2, { id = "Cat" })
			openSession(tr)
			tr:setOffer(1, { a })
			tr:ready(1)
			tr:ready(2)
			clock.advance(3)
			tr:confirm(1)
			local ok, err = tr:confirm(2)
			expect(ok).toBe(false)
			expect(err).toBe("full")
			expect(inv:has(1, a)).toBe(true)
			expect(inv:isLocked(1, a)).toBe(false)
		end)
		it("aborts if an offered item vanished before execution", function()
			local tr, inv, _, clock = make()
			local a = inv:add(1, { id = "Shark" })
			openSession(tr)
			tr:setOffer(1, { a })
			tr:ready(1)
			tr:ready(2)
			inv:remove(1, a, true) -- e.g. admin removal / exploit attempt
			clock.advance(3)
			tr:confirm(1)
			local ok, err = tr:confirm(2)
			expect(ok).toBe(false)
			expect(err).toBe("item_missing")
		end)
	end)
end
