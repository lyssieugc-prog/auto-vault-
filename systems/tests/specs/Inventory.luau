local Inventory = require("../../src/Shared/Inventory")

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	describe("Inventory", function()
		it("adds, caps capacity, removes", function()
			local inv = Inventory.new({ capacity = 2 })
			inv:load(1)
			local a = inv:add(1, { id = "Dog" })
			local b = inv:add(1, { id = "Cat" })
			local c, err = inv:add(1, { id = "Cow" })
			expect(a).toBe("i1")
			expect(b).toBe("i2")
			expect(c).toBeNil()
			expect(err).toBe("full")
			local item = inv:remove(1, a)
			expect(item.id).toBe("Dog")
			expect(inv:count(1)).toBe(1)
		end)
		it("rejects invalid items", function()
			local inv = Inventory.new()
			inv:load(1)
			local uid, err = inv:add(1, { name = "noId" })
			expect(uid).toBeNil()
			expect(err).toBe("invalid")
		end)
		it("equip slots and unequip on remove / slot reduction", function()
			local inv = Inventory.new({ equipSlots = 1 })
			inv:load(1)
			local a = inv:add(1, { id = "A" })
			local b = inv:add(1, { id = "B" })
			expect(inv:equip(1, a)).toBe(true)
			local ok, err = inv:equip(1, b)
			expect(ok).toBe(false)
			expect(err).toBe("slots_full")
			inv:setEquipSlots(1, 2)
			expect(inv:equip(1, b)).toBe(true)
			inv:setEquipSlots(1, 1)
			expect(#inv:equipped(1)).toBe(1)
			inv:remove(1, a)
			expect(#inv:equipped(1)).toBe(0)
		end)
		it("locked items cannot be removed without force", function()
			local inv = Inventory.new()
			inv:load(1)
			local a = inv:add(1, { id = "A" })
			inv:setLocked(1, a, true)
			local item, err = inv:remove(1, a)
			expect(item).toBeNil()
			expect(err).toBe("locked")
			expect(inv:remove(1, a, true).id).toBe("A")
		end)
		it("serializes and reloads without uid collisions", function()
			local inv = Inventory.new({ equipSlots = 2 })
			inv:load(1)
			local a = inv:add(1, { id = "A", rarity = "Epic" })
			inv:equip(1, a)
			local saved = inv:serialize(1)
			local inv2 = Inventory.new({ equipSlots = 2 })
			inv2:load(1, saved)
			expect(inv2:get(1, a).rarity).toBe("Epic")
			expect(inv2:equipped(1)[1]).toBe(a)
			local b = inv2:add(1, { id = "B" })
			expect(b ~= a).toBe(true)
		end)
		it("transfers between players", function()
			local inv = Inventory.new({ capacity = 1 })
			inv:load(1)
			inv:load(2)
			local a = inv:add(1, { id = "A" })
			local newUid = inv:transfer(1, 2, a)
			expect(newUid).toBeTruthy()
			expect(inv:count(1)).toBe(0)
			expect(inv:get(2, newUid).id).toBe("A")
			local b = inv:add(1, { id = "B" })
			local none, err = inv:transfer(1, 2, b)
			expect(none).toBeNil()
			expect(err).toBe("full")
			expect(inv:has(1, b)).toBe(true)
		end)
		it("list returns copies", function()
			local inv = Inventory.new()
			inv:load(1)
			local a = inv:add(1, { id = "A" })
			inv:list(1)[a].id = "Hacked"
			expect(inv:get(1, a).id).toBe("A")
		end)
	end)
end
